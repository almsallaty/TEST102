<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_audit_log_tree" model="ir.ui.view">
        <field name="name">rental.contract.audit.log.tree</field>
        <field name="model">rental.contract.audit.log</field>
        <field name="arch" type="xml">
            <list default_order="event_datetime desc" create="0" delete="0" edit="0">
                <field name="event_datetime"/>
                <field name="contract_id"/>
                <field name="vehicle_id" optional="show"/>
                <field name="customer_id" optional="show"/>
                <field name="action_type"/>
                <field name="field_name" optional="hide"/>
                <field name="old_value" optional="hide"/>
                <field name="new_value" optional="hide"/>
                <field name="user_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_contract_audit_log_form" model="ir.ui.view">
        <field name="name">rental.contract.audit.log.form</field>
        <field name="model">rental.contract.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="vehicle_id"/>
                            <field name="customer_id"/>
                            <field name="action_type"/>
                        </group>
                        <group>
                            <field name="event_datetime"/>
                            <field name="user_id"/>
                            <field name="field_name"/>
                        </group>
                    </group>
                    <group>
                        <group><field name="old_value"/></group>
                        <group><field name="new_value"/></group>
                    </group>
                    <group><field name="description" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_contract_audit_log_search" model="ir.ui.view">
        <field name="name">rental.contract.audit.log.search</field>
        <field name="model">rental.contract.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="user_id"/>
                <field name="action_type"/>
                <field name="field_name"/>
            </search>
        </field>
    </record>

    <record id="action_contract_audit_logs" model="ir.actions.act_window">
        <field name="name">Contract Audit Logs</field>
        <field name="res_model">rental.contract.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vehicle_rental_car_audit_reports.view_contract_audit_log_search"/>
    </record>
</odoo>
