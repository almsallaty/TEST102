<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_form_audit_reports" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.audit.reports</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="vehicle_rental.renta_fleet_vehicle_inherit_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_movement_logs" icon="fa-history">
                    <field name="movement_log_count" string="Logs" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Audit &amp; Reports">
                    <group>
                        <group string="Rental Performance">
                            <field name="x_rental_contract_total" readonly="1"/>
                            <field name="x_total_rented_days" readonly="1"/>
                            <field name="x_total_rented_hours" readonly="1"/>
                            <field name="x_total_rental_revenue" readonly="1"/>
                            <field name="x_avg_revenue_per_contract" readonly="1"/>
                            <field name="x_total_deposit_amount" readonly="1"/>
                            <field name="x_first_rental_date" readonly="1"/>
                            <field name="x_last_rental_date" readonly="1"/>
                        </group>
                        <group string="Maintenance / Cost">
                            <field name="x_maintenance_count" readonly="1"/>
                            <field name="x_total_maintenance_cost" readonly="1"/>
                            <field name="x_avg_maintenance_cost" readonly="1"/>
                            <field name="x_total_downtime_days" readonly="1"/>
                            <field name="x_total_downtime_hours" readonly="1"/>
                            <field name="x_last_maintenance_date" readonly="1"/>
                            <field name="x_total_trip_expense_cost" readonly="1"/>
                            <field name="x_total_operating_cost" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Profitability">
                            <field name="x_acquisition_cost" readonly="1"/>
                            <field name="x_net_profit" readonly="1"/>
                            <field name="x_utilization_rate" readonly="1"/>
                            <field name="x_idle_days" readonly="1"/>
                            <field name="x_total_cost_per_day" readonly="1"/>
                        </group>
                    </group>
                    <group string="Printable Reports" col="4">
                        <button name="action_print_car_profile" type="object" string="Car Profile PDF" class="btn btn-primary"/>
                        <button name="action_print_car_history" type="object" string="Car History PDF" class="btn btn-secondary"/>
                        <button name="action_print_car_rental" type="object" string="Car Rental PDF" class="btn btn-secondary"/>
                        <button name="action_print_car_maintenance" type="object" string="Car Maintenance PDF" class="btn btn-secondary"/>
                        <button name="action_print_car_financial" type="object" string="Car Financial PDF" class="btn btn-secondary"/>
                        <button name="action_print_car_utilization" type="object" string="Car Utilization PDF" class="btn btn-secondary"/>
                        <button name="action_print_car_documents" type="object" string="Car Documents PDF" class="btn btn-secondary"/>
                        <button name="action_print_car_customer_history" type="object" string="Customer History PDF" class="btn btn-secondary"/>
                        <button name="action_print_car_downtime" type="object" string="Downtime PDF" class="btn btn-secondary"/>
                        <button name="action_print_fleet_summary" type="object" string="Fleet Summary PDF" class="btn btn-secondary"/>
                    </group>
                    <field name="movement_log_ids" nolabel="1">
                        <list default_order="event_datetime desc" create="0" delete="0" edit="0">
                            <field name="event_datetime"/>
                            <field name="event_type"/>
                            <field name="field_name" optional="hide"/>
                            <field name="old_value" optional="hide"/>
                            <field name="new_value" optional="hide"/>
                            <field name="contract_id" optional="show"/>
                            <field name="maintenance_request_id" optional="show"/>
                            <field name="user_id"/>
                            <field name="description"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
