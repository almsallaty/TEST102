<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vehicle_contract_form_audit_reports" model="ir.ui.view">
        <field name="name">vehicle.contract.form.audit.reports</field>
        <field name="model">vehicle.contract</field>
        <field name="inherit_id" ref="vehicle_rental.vehicle_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_audit_logs" icon="fa-history">
                    <field name="audit_log_count" string="Audit Logs" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_print_contract_audit" type="object" string="Contract Audit PDF" class="btn btn-primary"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Audit Trail">
                    <group>
                        <group>
                            <field name="x_contract_total_days" readonly="1"/>
                            <field name="x_contract_total_hours" readonly="1"/>
                            <field name="x_contract_revenue_total" readonly="1"/>
                        </group>
                    </group>
                    <field name="audit_log_ids" nolabel="1">
                        <list default_order="event_datetime desc" create="0" delete="0" edit="0">
                            <field name="event_datetime"/>
                            <field name="action_type"/>
                            <field name="field_name" optional="hide"/>
                            <field name="old_value" optional="hide"/>
                            <field name="new_value" optional="hide"/>
                            <field name="user_id"/>
                            <field name="description"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
