                                    <td><t t-esc="m.destination_location_id.display_name or ''"/></td>
                                    <td><t t-esc="m.picking_id.name or ''"/></td>
                                    <td><t t-esc="m.note or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="baroon-section-title">Financial Detail</div>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Expense/Bill</th><th>Type</th><th>Partner</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.expense_ids" t-as="e">
                                    <td><t t-esc="e.name or ''"/></td>
                                    <td><t t-esc="dict(e._fields['expense_type'].selection).get(e.expense_type, e.expense_type)"/></td>
                                    <td><t t-esc="e.vendor_id.display_name or ''"/></td>
                                    <td><t t-esc="e.expense_date or ''"/></td>
                                    <td><span t-field="e.amount" t-options='{"widget": "monetary", "display_currency": e.currency_id}'/></td>
                                    <td><t t-esc="e.bill_payment_state or e.state or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="baroon-section-title">Sales and Test Drive Activity</div>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Reference</th><th>Customer</th><th>Type</th><th>Status</th><th>Scheduled / Date</th><th>Amount</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.test_drive_ids" t-as="td">
                                    <td><t t-esc="td.name or ''"/></td>
                                    <td><t t-esc="td.partner_id.display_name or ''"/></td>
                                    <td>Test Drive</td>
                                    <td><t t-esc="dict(td._fields['state'].selection).get(td.state, td.state)"/></td>
                                    <td><t t-esc="td.scheduled_datetime or ''"/></td>
                                    <td><span t-field="td.security_deposit" t-options='{"widget": "monetary", "display_currency": td.currency_id}'/></td>
                                </tr>
                                <tr t-if="o.sale_order_id">
                                    <td><t t-esc="o.sale_order_id.name or ''"/></td>
                                    <td><t t-esc="o.sale_order_id.partner_id.display_name or ''"/></td>
                                    <td>Sale Order</td>
                                    <td><t t-esc="o.sale_order_id.state or ''"/></td>
                                    <td><t t-esc="o.sale_order_id.date_order or ''"/></td>
                                    <td><span t-field="o.sale_order_id.amount_total" t-options='{"widget": "monetary", "display_currency": o.sale_order_id.currency_id}'/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="baroon-section-title">Audit Trail</div>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Date</th><th>Type</th><th>Field</th><th>Old Value</th><th>New Value</th><th>Description</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.audit_log_ids[:25]" t-as="a">
                                    <td><t t-esc="a.event_datetime or ''"/></td>
                                    <td><t t-esc="dict(a._fields['change_type'].selection).get(a.change_type, a.change_type)"/></td>
                                    <td><t t-esc="a.field_name or ''"/></td>
                                    <td><t t-esc="a.old_value or ''"/></td>
                                    <td><t t-esc="a.new_value or ''"/></td>
                                    <td><t t-esc="a.description or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
