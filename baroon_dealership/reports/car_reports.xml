    <record id="action_report_landed_cost" model="ir.actions.report">
        <field name="name">Landed Cost Car Allocation</field>
        <field name="model">stock.landed.cost</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_landed_cost</field>
        <field name="report_file">baroon_dealership.report_landed_cost</field>
        <field name="binding_model_id" ref="stock_landed_costs.model_stock_landed_cost"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_common_styles">
        <style>
            .baroon-title { font-size: 24px; font-weight: 700; margin-bottom: 6px; color: #0f274b; letter-spacing: .2px; }
            .baroon-subtitle { color: #4f5f73; margin-bottom: 14px; }
            .baroon-section-title {
                font-size: 16px;
                font-weight: 700;
                margin-top: 20px;
                margin-bottom: 8px;
                padding-bottom: 5px;
                border-bottom: 1px solid #c8d2df;
                color: #163963;
            }
            .baroon-kpi-row { width: 100%; border-collapse: separate; border-spacing: 8px; margin-bottom: 12px; }
            .baroon-kpi {
                width: 25%;
                border: 1px solid #d4deea;
                border-radius: 10px;
                padding: 10px;
                background: #f8fbff;
            }
            .baroon-kpi .label { font-size: 11px; color: #5b6f88; text-transform: uppercase; font-weight: 600; }
            .baroon-kpi .value { font-size: 18px; font-weight: 700; margin-top: 4px; color: #132f57; }
            .baroon-gallery img {
                max-width: 170px;
                max-height: 120px;
                margin-right: 8px;
                margin-bottom: 8px;
                border: 1px solid #c8d2df;
                border-radius: 6px;
                padding: 2px;
                background: #fff;
            }
            .table { border-color: #dbe3ee !important; }
            .table thead th { background: #eef4fb; color: #1f446f; font-weight: 700; border-color: #dbe3ee !important; }
            .table td, .table th { vertical-align: middle; border-color: #dbe3ee !important; }
            .page { font-size: 12px; color: #1e2f46; }
        </style>
    </template>

    <template id="report_car_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="baroon_dealership.report_common_styles"/>
                    <div class="page">
                        <div class="row mb-3">
                            <div class="col-8">
                                <div class="baroon-title">Vehicle Profile</div>
                                <div class="baroon-subtitle"><strong><t t-esc="o.product_id.display_name or ''"/></strong> — VIN <t t-esc="o.name or ''"/></div>
                                <div>Status: <strong><t t-esc="dict(o._fields['car_status'].selection).get(o.car_status, '')"/></strong></div>
                                <div>Sales Stage Owner: <t t-esc="o.salesperson_id.name or ''"/></div>
                            </div>
                            <div class="col-4 text-end">
                                <img t-if="o.display_cover_image" t-att-src="image_data_uri(o.display_cover_image)" style="max-width: 220px; max-height: 160px; border: 1px solid #ccc;"/>
                            </div>
                        </div>

                        <table class="baroon-kpi-row">
                            <tr>
                                <td class="baroon-kpi"><div class="label">Sale Price</div><div class="value"><span t-field="o.sale_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></div></td>
                                <td class="baroon-kpi"><div class="label">Total Cost</div><div class="value"><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></div></td>
                                <td class="baroon-kpi"><div class="label">Gross Margin</div><div class="value"><span t-field="o.gross_margin" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></div></td>
                                <td class="baroon-kpi"><div class="label">Days In Stock</div><div class="value"><t t-esc="o.days_in_stock or 0"/></div></td>
                            </tr>
                        </table>

                        <div class="baroon-section-title">Vehicle Identity</div>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td><strong>Brand</strong></td><td><t t-esc="o.car_brand or ''"/></td><td><strong>Model</strong></td><td><t t-esc="o.car_model or ''"/></td></tr>
                                <tr><td><strong>Trim</strong></td><td><t t-esc="o.car_trim or ''"/></td><td><strong>Year</strong></td><td><t t-esc="o.year or ''"/></td></tr>
                                <tr><td><strong>Engine Number</strong></td><td><t t-esc="o.engine_number or ''"/></td><td><strong>Plate Number</strong></td><td><t t-esc="o.plate_number or ''"/></td></tr>
                                <tr><td><strong>Body Style</strong></td><td><t t-esc="dict(o._fields['body_style'].selection).get(o.body_style, '') if o.body_style else ''"/></td><td><strong>Condition</strong></td><td><t t-esc="dict(o._fields['condition'].selection).get(o.condition, '') if o.condition else ''"/></td></tr>
                                <tr><td><strong>Fuel Type</strong></td><td><t t-esc="dict(o._fields['fuel_type'].selection).get(o.fuel_type, '') if o.fuel_type else ''"/></td><td><strong>Gearbox</strong></td><td><t t-esc="dict(o._fields['gearbox_type'].selection).get(o.gearbox_type, '') if o.gearbox_type else ''"/></td></tr>
                                <tr><td><strong>Mileage</strong></td><td><t t-esc="o.mileage or 0"/></td><td><strong>Current Location</strong></td><td><t t-esc="o.current_location_id.display_name or o.branch_location or ''"/></td></tr>
                            </tbody>
                        </table>

                        <div class="baroon-section-title">Purchase, Shipment, and Delivery</div>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td><strong>Vendor</strong></td><td><t t-esc="o.purchase_partner_id.display_name or ''"/></td><td><strong>Purchase Order</strong></td><td><t t-esc="o.purchase_order_id.name or ''"/></td></tr>
                                <tr><td><strong>Purchase Date</strong></td><td><t t-esc="o.purchase_date or ''"/></td><td><strong>Shipment Ref</strong></td><td><t t-esc="o.shipping_reference or ''"/></td></tr>
                                <tr><td><strong>Port of Loading</strong></td><td><t t-esc="o.port_of_loading or ''"/></td><td><strong>Destination Port</strong></td><td><t t-esc="o.destination_port or ''"/></td></tr>
                                <tr><td><strong>ETA</strong></td><td><t t-esc="o.expected_arrival_date or ''"/></td><td><strong>Arrival</strong></td><td><t t-esc="o.arrival_date or ''"/></td></tr>
                                <tr><td><strong>Customs Release</strong></td><td><t t-esc="o.customs_release_date or ''"/></td><td><strong>Delivered Date</strong></td><td><t t-esc="o.delivered_date or ''"/></td></tr>
                            </tbody>
                        </table>

                        <div class="baroon-section-title">Commercial Snapshot</div>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td><strong>Reserved For</strong></td><td><t t-esc="o.reservation_partner_id.display_name or ''"/></td><td><strong>Reserved Until</strong></td><td><t t-esc="o.reserved_until or ''"/></td></tr>
                                <tr><td><strong>Reserved By Order</strong></td><td><t t-esc="o.reservation_order_id.name or ''"/></td><td><strong>Buyer</strong></td><td><t t-esc="o.buyer_id.display_name or ''"/></td></tr>
                                <tr><td><strong>Sale Order</strong></td><td><t t-esc="o.sale_order_id.name or ''"/></td><td><strong>Opportunities</strong></td><td><t t-esc="o.crm_lead_count or 0"/></td></tr>
                                <tr><td><strong>Quotations</strong></td><td><t t-esc="o.quotation_count or 0"/></td><td><strong>Movement Command</strong></td><td><t t-esc="o.movement_command or ''"/></td></tr>
                            </tbody>
                        </table>

                        <div class="baroon-section-title">Movement Snapshot</div>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Date</th><th>Type</th><th>From</th><th>To</th><th>Document</th><th>User</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.location_history_ids[:12]" t-as="m">
                                    <td><t t-esc="m.movement_date or ''"/></td>
                                    <td><t t-esc="dict(m._fields['movement_type'].selection).get(m.movement_type, m.movement_type)"/></td>
                                    <td><t t-esc="m.source_location_id.display_name or ''"/></td>
                                    <td><t t-esc="m.destination_location_id.display_name or ''"/></td>
                                    <td><t t-esc="m.picking_id.name or ''"/></td>
                                    <td><t t-esc="m.user_id.name or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_car_profitability">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="baroon_dealership.report_common_styles"/>
                    <div class="page">
                        <div class="baroon-title">Vehicle Profitability Report</div>
                        <div class="baroon-subtitle"><t t-esc="o.product_id.display_name or ''"/> — VIN <t t-esc="o.name or ''"/></div>
                        <table class="baroon-kpi-row">
                            <tr>
                                <td class="baroon-kpi"><div class="label">Sale Price</div><div class="value"><span t-field="o.sale_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></div></td>
                                <td class="baroon-kpi"><div class="label">Total Cost</div><div class="value"><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></div></td>
                                <td class="baroon-kpi"><div class="label">Gross Margin</div><div class="value"><span t-field="o.gross_margin" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></div></td>
                                <td class="baroon-kpi"><div class="label">Margin %</div><div class="value"><t t-esc="'%.2f' % (o.margin_percent or 0.0)"/>%</div></td>
                            </tr>
                        </table>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td>Purchase Cost</td><td><span t-field="o.purchase_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Manual Landed Cost</td><td><span t-field="o.landed_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Linked Landed Cost</td><td><span t-field="o.landed_cost_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Reconditioning</td><td><span t-field="o.reconditioning_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Other Expenses</td><td><span t-field="o.expense_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td><strong>Total Cost</strong></td><td><strong><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td></tr>
                            </tbody>
                        </table>
                        <div class="baroon-section-title">Expense Detail</div>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Date</th><th>Name</th><th>Type</th><th>Vendor</th><th>Amount</th><th>Bill</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.expense_ids" t-as="e">
                                    <td><t t-esc="e.expense_date or ''"/></td>
                                    <td><t t-esc="e.name or ''"/></td>
                                    <td><t t-esc="dict(e._fields['expense_type'].selection).get(e.expense_type, e.expense_type)"/></td>
                                    <td><t t-esc="e.vendor_id.display_name or ''"/></td>
                                    <td><span t-field="e.amount" t-options='{"widget": "monetary", "display_currency": e.currency_id}'/></td>
                                    <td><t t-esc="e.account_move_id.name or e.account_move_id.ref or ''"/></td>
                                    <td><t t-esc="e.state or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="baroon-section-title">Landed Cost Allocations</div>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Name</th><th>Status</th><th>Total</th><th>Allocated Share</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.landed_cost_ids" t-as="lc">
                                    <td><t t-esc="lc.name or ''"/></td>
                                    <td><t t-esc="lc.state or ''"/></td>
                                    <td><span t-field="lc.amount_total" t-options='{"widget": "monetary", "display_currency": lc.company_id.currency_id}'/></td>
                                    <td><span t-esc="(lc.amount_total or 0.0) / (len(lc.car_lot_ids) or 1)"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_car_accounting">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="baroon_dealership.report_common_styles"/>
                    <div class="page">
                        <div class="baroon-title">Vehicle Accounting Report</div>
                        <div class="baroon-subtitle"><t t-esc="o.product_id.display_name or ''"/> — VIN <t t-esc="o.name or ''"/></div>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td><strong>Vendor Bill Count</strong></td><td><t t-esc="o.vendor_bill_count or 0"/></td><td><strong>Customer Invoice Count</strong></td><td><t t-esc="o.invoice_count or 0"/></td></tr>
                                <tr><td><strong>Landed Cost Count</strong></td><td><t t-esc="o.landed_cost_count or 0"/></td><td><strong>Total Cost</strong></td><td><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                            </tbody>
                        </table>
                        <div class="baroon-section-title">Linked Bills and Invoices</div>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Document</th><th>Type</th><th>Partner</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr t-foreach="(o.vendor_bill_ids | (o.sale_order_id and o.sale_order_id.invoice_ids or o.env['account.move']))" t-as="b">
                                    <td><t t-esc="b.name or b.ref or ''"/></td>
                                    <td><t t-esc="b.move_type or ''"/></td>
                                    <td><t t-esc="b.partner_id.display_name or ''"/></td>
                                    <td><t t-esc="b.invoice_date or ''"/></td>
                                    <td><span t-field="b.amount_total" t-options='{"widget": "monetary", "display_currency": b.currency_id}'/></td>
                                    <td><t t-esc="b.payment_state or b.state or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_car_executive_summary">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="baroon_dealership.report_common_styles"/>
                <div class="page">
                    <div class="baroon-title">Executive Inventory Summary</div>
                    <div class="baroon-subtitle">Portfolio overview for the selected VIN records.</div>
                    <table class="baroon-kpi-row">
                        <tr>
                            <td class="baroon-kpi"><div class="label">Cars</div><div class="value"><t t-esc="len(docs)"/></div></td>
                            <td class="baroon-kpi"><div class="label">Asking Value</div><div class="value"><span t-esc="sum(docs.mapped('sale_price'))" t-options='{"widget": "monetary", "display_currency": docs[:1].currency_id if docs else False}'/></div></td>
                            <td class="baroon-kpi"><div class="label">Total Cost</div><div class="value"><span t-esc="sum(docs.mapped('total_cost'))" t-options='{"widget": "monetary", "display_currency": docs[:1].currency_id if docs else False}'/></div></td>
                            <td class="baroon-kpi"><div class="label">Projected Margin</div><div class="value"><span t-esc="sum(docs.mapped('gross_margin'))" t-options='{"widget": "monetary", "display_currency": docs[:1].currency_id if docs else False}'/></div></td>
                        </tr>
                    </table>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr><th>VIN</th><th>Vehicle</th><th>Status</th><th>Location</th><th>Vendor</th><th>Buyer</th><th>Total Cost</th><th>Sale Price</th><th>Margin</th><th>Days In Stock</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="o">
                                <td><t t-esc="o.name or ''"/></td>
                                <td><t t-esc="o.product_id.display_name or ''"/></td>
                                <td><t t-esc="dict(o._fields['car_status'].selection).get(o.car_status, '')"/></td>
                                <td><t t-esc="o.current_location_id.display_name or o.branch_location or ''"/></td>
                                <td><t t-esc="o.purchase_partner_id.display_name or ''"/></td>
                                <td><t t-esc="o.buyer_id.display_name or ''"/></td>
                                <td><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td><span t-field="o.sale_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td><span t-field="o.gross_margin" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td><t t-esc="o.days_in_stock or 0"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_car_operations_pack">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="baroon_dealership.report_common_styles"/>
                    <div class="page">
                        <div class="baroon-title">Vehicle Operations Pack</div>
                        <div class="baroon-subtitle"><t t-esc="o.product_id.display_name or ''"/> — VIN <t t-esc="o.name or ''"/></div>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td><strong>Status</strong></td><td><t t-esc="dict(o._fields['car_status'].selection).get(o.car_status, o.car_status)"/></td><td><strong>Location</strong></td><td><t t-esc="o.current_location_id.display_name or o.branch_location or ''"/></td></tr>
