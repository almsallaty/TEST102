<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_baroon_dealership" model="report.paperformat">
        <field name="name">Baroon Dealership A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_car_profile" model="ir.actions.report">
        <field name="name">Car Profile</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_profile</field>
        <field name="report_file">baroon_dealership.report_car_profile</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_baroon_dealership"/>
    </record>

    <record id="action_report_car_profitability" model="ir.actions.report">
        <field name="name">Car Profitability</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_profitability</field>
        <field name="report_file">baroon_dealership.report_car_profitability</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_baroon_dealership"/>
    </record>

    <record id="action_report_car_cost_sheet" model="ir.actions.report">
        <field name="name">Car Cost Sheet</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_cost_sheet</field>
        <field name="report_file">baroon_dealership.report_car_cost_sheet</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_baroon_dealership"/>
    </record>

    <record id="action_report_car_executive_summary" model="ir.actions.report">
        <field name="name">Executive Car Summary</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_executive_summary</field>
        <field name="report_file">baroon_dealership.report_car_executive_summary</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_baroon_dealership"/>
    </record>


    <record id="action_report_car_history" model="ir.actions.report">
        <field name="name">Car History</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_history</field>
        <field name="report_file">baroon_dealership.report_car_history</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_baroon_dealership"/>
    </record>

    <record id="action_report_car_handover" model="ir.actions.report">
        <field name="name">Car Delivery Sheet</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_handover</field>
        <field name="report_file">baroon_dealership.report_car_handover</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_baroon_dealership"/>
    </record>

    <template id="report_car_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">
                        <h2 style="margin-bottom: 10px;">Car Profile</h2>
                        <div class="row" style="margin-bottom: 10px;">
                            <div class="col-8">
                                <h3 style="margin: 0;"><span t-esc="o.car_brand or ''"/> <span t-esc="o.car_model or ''"/> <span t-esc="o.car_trim or ''"/></h3>
                                <p style="margin: 4px 0 0 0; color: #666;">VIN: <span t-esc="o.name or ''"/> · Status: <span t-esc="dict(o._fields['car_status'].selection).get(o.car_status, '')"/></p>
                            </div>
                            <div class="col-4" style="text-align: right;">
                                <img t-if="o.display_cover_image" t-att-src="image_data_uri(o.display_cover_image)" style="max-width: 180px; max-height: 120px;"/>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td><strong>Product</strong></td><td><span t-esc="o.product_id.display_name or ''"/></td><td><strong>Year</strong></td><td><span t-esc="o.year or ''"/></td></tr>
                                <tr><td><strong>Engine No.</strong></td><td><span t-esc="o.engine_number or ''"/></td><td><strong>Plate No.</strong></td><td><span t-esc="o.plate_number or ''"/></td></tr>
                                <tr><td><strong>Condition</strong></td><td><span t-esc="dict(o._fields['condition'].selection).get(o.condition, '')"/></td><td><strong>Current Location</strong></td><td><span t-esc="o.current_location_id.display_name or o.branch_location or ''"/></td></tr>
                                <tr><td><strong>Fuel</strong></td><td><span t-esc="dict(o._fields['fuel_type'].selection).get(o.fuel_type, '')"/></td><td><strong>Gearbox</strong></td><td><span t-esc="dict(o._fields['gearbox_type'].selection).get(o.gearbox_type, '')"/></td></tr>
                                <tr><td><strong>Mileage</strong></td><td><span t-esc="o.mileage or 0"/></td><td><strong>Horse Power</strong></td><td><span t-esc="o.horse_power or 0"/></td></tr>
                                <tr><td><strong>Vendor</strong></td><td><span t-esc="o.purchase_partner_id.display_name or ''"/></td><td><strong>Purchase Order</strong></td><td><span t-esc="o.purchase_order_id.name or ''"/></td></tr>
                                <tr><td><strong>Shipment Ref.</strong></td><td><span t-esc="o.shipping_reference or ''"/></td><td><strong>ETA</strong></td><td><span t-esc="o.expected_arrival_date or ''"/></td></tr>
                                <tr><td><strong>Reserved For</strong></td><td><span t-esc="o.reservation_partner_id.display_name or ''"/></td><td><strong>Buyer</strong></td><td><span t-esc="o.buyer_id.display_name or ''"/></td></tr>
                            </tbody>
                        </table>
                        <div style="margin-top: 12px;">
                            <strong>Website Summary</strong>
                            <p t-esc="o.website_short_description or ''"/>
                        </div>
                        <div style="margin-top: 12px;">
                            <strong>Internal Notes</strong>
                            <p t-esc="o.notes or ''"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_car_profitability">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Car Profitability</h2>
                        <h3><span t-esc="o.display_name_website or o.display_name"/></h3>
                        <table class="table table-sm table-bordered mt16">
                            <tbody>
                                <tr><td>Purchase Cost</td><td><span t-field="o.purchase_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Shipping</td><td><span t-field="o.shipping_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Customs</td><td><span t-field="o.customs_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Landed Cost</td><td><span t-field="o.landed_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Reconditioning</td><td><span t-field="o.reconditioning_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Other Expenses</td><td><span t-field="o.extra_expense_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr class="total-row"><td><strong>Total Cost</strong></td><td><strong><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td></tr>
                                <tr><td>Sale Price</td><td><span t-field="o.sale_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Gross Margin</td><td><span t-field="o.gross_margin" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><td>Margin %</td><td><span t-esc="'%.2f %%' % (o.margin_percent or 0.0)"/></td></tr>
                            </tbody>
                        </table>
                        <h4>Expense Breakdown</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>Date</th><th>Type</th><th>Description</th><th>Reference</th><th>Amount</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.expense_ids" t-as="exp">
                                    <td><span t-esc="exp.expense_date or ''"/></td>
                                    <td><span t-esc="dict(exp._fields['expense_type'].selection).get(exp.expense_type, '')"/></td>
                                    <td><span t-esc="exp.name or ''"/></td>
                                    <td><span t-esc="exp.reference or ''"/></td>
                                    <td><span t-field="exp.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_car_cost_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Car Cost Sheet</h2>
                        <h3><span t-esc="o.display_name_website or o.display_name"/></h3>
                        <table class="table table-sm table-bordered mt16">
                            <thead>
                                <tr><th>Cost Source</th><th>Reference</th><th>Amount</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Purchase Order</td><td><span t-esc="o.purchase_order_id.name or ''"/></td><td><span t-field="o.purchase_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <t t-foreach="o.landed_cost_record_ids" t-as="lc">
                                    <tr t-if="lc.state == 'done'">
                                        <td>Landed Cost</td>
                                        <td><span t-esc="lc.name or ''"/></td>
                                        <td><span t-esc="'%.2f' % (lc._get_dealership_allocation_map().get(o.id, 0.0))"/></td>
                                    </tr>
                                </t>
                                <tr t-foreach="o.expense_ids" t-as="exp">
                                    <td><span t-esc="dict(exp._fields['expense_type'].selection).get(exp.expense_type, '')"/></td>
                                    <td><span t-esc="exp.reference or exp.name or ''"/></td>
                                    <td><span t-field="exp.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                                <tr class="total-row"><td colspan="2"><strong>Total Cost</strong></td><td><strong><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td></tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_car_handover">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Car Delivery / Handover Sheet</h2>
                        <table class="table table-sm table-bordered mt16">
                            <tbody>
                                <tr><td><strong>Car</strong></td><td><span t-esc="o.display_name_website or o.display_name"/></td></tr>
                                <tr><td><strong>VIN</strong></td><td><span t-esc="o.name or ''"/></td></tr>
                                <tr><td><strong>Plate Number</strong></td><td><span t-esc="o.plate_number or ''"/></td></tr>
                                <tr><td><strong>Engine Number</strong></td><td><span t-esc="o.engine_number or ''"/></td></tr>
                                <tr><td><strong>Buyer</strong></td><td><span t-esc="o.buyer_id.display_name or o.reservation_partner_id.display_name or ''"/></td></tr>
                                <tr><td><strong>Sales Order</strong></td><td><span t-esc="o.sale_order_id.name or o.reservation_order_id.name or ''"/></td></tr>
                                <tr><td><strong>Current Location</strong></td><td><span t-esc="o.current_location_id.display_name or o.branch_location or ''"/></td></tr>
                                <tr><td><strong>Condition</strong></td><td><span t-esc="dict(o._fields['condition'].selection).get(o.condition, '')"/></td></tr>
                            </tbody>
                        </table>
                        <div style="margin-top: 30px;">
                            <table style="width:100%; border:none;">
                                <tr>
                                    <td style="width: 45%; border:none; padding-top: 40px;">Warehouse Signature: _________________________</td>
                                    <td style="width: 10%; border:none;"></td>
                                    <td style="width: 45%; border:none; padding-top: 40px;">Customer Signature: _________________________</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_car_executive_summary">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Executive Car Summary</h2>
                    <table class="table table-sm table-bordered mt16">
                        <thead>
                            <tr>
                                <th>VIN</th><th>Car</th><th>Status</th><th>Vendor</th><th>Buyer</th><th>Location</th><th>Total Cost</th><th>Sale Price</th><th>Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="o">
                                <td><span t-esc="o.name or ''"/></td>
                                <td><span t-esc="o.display_name_website or o.display_name"/></td>
                                <td><span t-esc="dict(o._fields['car_status'].selection).get(o.car_status, '')"/></td>
                                <td><span t-esc="o.purchase_partner_id.display_name or ''"/></td>
                                <td><span t-esc="o.buyer_id.display_name or ''"/></td>
                                <td><span t-esc="o.current_location_id.display_name or o.branch_location or ''"/></td>
                                <td><span t-field="o.total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td><span t-field="o.sale_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                <td><span t-field="o.gross_margin" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_car_history">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Car History Report</h2>
                        <h3><span t-esc="o.display_name_website or o.display_name"/></h3>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><td><strong>VIN</strong></td><td><span t-esc="o.name or ''"/></td><td><strong>Status</strong></td><td><span t-esc="dict(o._fields['car_status'].selection).get(o.car_status, '')"/></td></tr>
                                <tr><td><strong>Plate</strong></td><td><span t-esc="o.plate_number or ''"/></td><td><strong>Engine</strong></td><td><span t-esc="o.engine_number or ''"/></td></tr>
                            </tbody>
                        </table>
                        <h4>Location History</h4>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Date</th><th>From</th><th>To</th><th>Reference</th><th>Note</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.location_history_ids" t-as="l">
                                    <td><span t-esc="l.move_date or ''"/></td>
                                    <td><span t-esc="l.source_location_id.display_name or ''"/></td>
                                    <td><span t-esc="l.destination_location_id.display_name or ''"/></td>
                                    <td><span t-esc="l.reference or ''"/></td>
                                    <td><span t-esc="l.note or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h4>Audit Trail</h4>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Date</th><th>User</th><th>Field</th><th>Old</th><th>New</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.audit_log_ids" t-as="a">
                                    <td><span t-esc="a.change_datetime or ''"/></td>
                                    <td><span t-esc="a.user_id.display_name or ''"/></td>
                                    <td><span t-esc="a.field_label or ''"/></td>
                                    <td><span t-esc="a.old_value or ''"/></td>
                                    <td><span t-esc="a.new_value or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
