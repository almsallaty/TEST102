    <record id="action_report_car_movement" model="ir.actions.report">
        <field name="name">Movement Report</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_movement</field>
        <field name="report_file">baroon_dealership.report_car_movement</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_car_operations_pack" model="ir.actions.report">
        <field name="name">Operations Pack</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_operations_pack</field>
        <field name="report_file">baroon_dealership.report_car_operations_pack</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_car_master_dossier" model="ir.actions.report">
        <field name="name">Master Vehicle Dossier</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baroon_dealership.report_car_master_dossier</field>
        <field name="report_file">baroon_dealership.report_car_master_dossier</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
