<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="car_rule_inventory_clerk" model="ir.rule">
        <field name="name">Inventory Clerk car access</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('baroon_dealership.group_inventory_clerk'))]"/>
        <field name="domain_force">[('is_car_vehicle', '=', True)]</field>
    </record>
    <record id="car_rule_sales_agent" model="ir.rule">
        <field name="name">Sales Agent car access</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('baroon_dealership.group_sales_agent'))]"/>
        <field name="domain_force">[('is_car_vehicle', '=', True)]</field>
    </record>
    <record id="car_rule_accountant" model="ir.rule">
        <field name="name">Accountant car access</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('baroon_dealership.group_accountant'))]"/>
        <field name="domain_force">[('is_car_vehicle', '=', True)]</field>
    </record>
    <record id="car_rule_executive" model="ir.rule">
        <field name="name">Executive car access</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('baroon_dealership.group_executive'))]"/>
        <field name="domain_force">[('is_car_vehicle', '=', True)]</field>
    </record>
</odoo>
