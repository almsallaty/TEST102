<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dealership_user" model="res.groups">
        <field name="name">Dealership User</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_sales_agent" model="res.groups">
        <field name="name">Sales Agent</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('baroon_dealership.group_dealership_user'))]"/>
    </record>
    <record id="group_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('baroon_dealership.group_sales_agent'))]"/>
    </record>
    <record id="group_inventory_clerk" model="res.groups">
        <field name="name">Inventory Clerk</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('baroon_dealership.group_dealership_user'))]"/>
    </record>
    <record id="group_accountant" model="res.groups">
        <field name="name">Dealership Accountant</field>
        <field name="category_id" ref="account.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('baroon_dealership.group_dealership_user'))]"/>
    </record>
    <record id="group_executive" model="res.groups">
        <field name="name">Executive</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('baroon_dealership.group_sales_manager')), (4, ref('baroon_dealership.group_inventory_clerk')), (4, ref('baroon_dealership.group_accountant'))]"/>
    </record>
</odoo>
