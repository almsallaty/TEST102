<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="baroon_dealership.ExecutiveDashboard">
        <div class="o_bds_scope p-4">
            <t t-if="!state.loaded">
                <div class="text-center p-5"><h3>Loading executive data...</h3></div>
            </t>
            <t t-else="">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="bds-title-lg">Executive Cockpit</h2>
                    <button class="bds-btn bds-btn--outline" t-on-click="refresh">Refresh</button>
                </div>
                <div class="bds-grid bds-grid--cols-auto bds-section">
                    <div class="bds-card bds-card--clickable bds-kpi" t-on-click="openInventory">
                        <span class="bds-label">Active Inventory</span>
                        <span class="bds-value" t-esc="state.hero.inventory_count"/>
                        <span class="bds-kpi__trend bds-kpi__trend--neutral">Cost: <t t-esc="state.hero.inventory_cost"/> <t t-esc="state.currency.symbol"/></span>
                    </div>
                    <div class="bds-card bds-card--clickable bds-kpi" t-on-click="openAvailable">
                        <span class="bds-label">Available</span>
                        <span class="bds-value" t-esc="state.hero.available"/>
                        <span class="bds-kpi__trend bds-kpi__trend--neutral">Revenue: <t t-esc="state.hero.expected_revenue"/> <t t-esc="state.currency.symbol"/></span>
                    </div>
                    <div class="bds-card bds-card--clickable bds-kpi" t-on-click="openSold">
                        <span class="bds-label">Sold This Month</span>
                        <span class="bds-value" t-esc="state.hero.sold_month"/>
                        <t t-if="state.hero.change">
                            <span t-att-class="'bds-kpi__trend ' + (state.hero.change &gt; 0 ? 'bds-kpi__trend--up' : 'bds-kpi__trend--down')"><t t-esc="state.hero.change"/>% vs last month</span>
                        </t>
                    </div>
                </div>
                <div class="bds-card bds-section" t-if="state.alerts.length">
                    <span class="bds-title">Alerts</span>
                    <div class="d-flex gap-2 mt-2 flex-wrap">
                        <t t-foreach="state.alerts" t-as="alert" t-key="alert.message">
                            <span t-att-class="'bds-pill bds-pill--' + alert.level" style="cursor:pointer;" t-on-click="() =&gt; handleAlert(alert)"><t t-esc="alert.message"/></span>
                        </t>
                    </div>
                </div>
                <div class="bds-grid bds-grid--cols-2 bds-section">
                    <div class="bds-chart-box"><span class="bds-title">Monthly Sales Trend</span><div t-ref="trend" style="height: 280px;"></div></div>
                    <div class="bds-chart-box"><span class="bds-title">Stock Distribution</span><div t-ref="dist" style="height: 280px;"></div></div>
                </div>
                <div class="bds-grid bds-grid--cols-2 bds-section">
                    <div class="bds-card">
                        <span class="bds-title">Top Models</span>
                        <ul class="list-unstyled mt-2">
                            <t t-if="state.top_models.length">
                                <t t-foreach="state.top_models" t-as="m" t-key="m.model"><li class="d-flex justify-content-between py-1"><strong t-esc="m.model"/><span t-esc="m.count"/></li></t>
                            </t>
                            <t t-else=""><li class="text-muted">No data available</li></t>
                        </ul>
                    </div>
                    <div class="bds-card">
                        <span class="bds-title">Top Salespeople</span>
                        <ul class="list-unstyled mt-2">
                            <t t-if="state.salespeople.length">
                                <t t-foreach="state.salespeople" t-as="sp" t-key="sp.name"><li class="d-flex justify-content-between py-1"><strong t-esc="sp.name"/><span t-esc="sp.total"/></li></t>
                            </t>
                            <t t-else=""><li class="text-muted">No data available</li></t>
                        </ul>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
