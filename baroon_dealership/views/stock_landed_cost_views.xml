<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_landed_cost_form_baroon_dealership" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.baroon.dealership</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Dealership Cars">
                    <group>
                        <field name="dealership_lot_ids" widget="many2many_tags" domain="[('is_car_vehicle', '=', True)]"/>
                        <field name="dealership_lot_count" readonly="1"/>
                    </group>
                    <div class="o_form_label">The total landed cost amount is allocated equally across the selected VIN records once the landed cost is validated.</div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
