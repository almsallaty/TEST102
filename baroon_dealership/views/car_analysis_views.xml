<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_graph_analysis" model="ir.ui.view">
        <field name="name">stock.lot.graph.dealership</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <graph string="Inventory Analysis" type="bar">
                <field name="car_status"/>
                <field name="sale_price" type="measure"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_stock_lot_pivot_analysis" model="ir.ui.view">
        <field name="name">stock.lot.pivot.dealership</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <pivot string="Inventory Analysis">
                <field name="car_status" type="row"/>
                <field name="car_brand" type="row"/>
                <field name="salesperson_id" type="col"/>
                <field name="sale_price" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="gross_margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_car_active_inventory" model="ir.actions.act_window">
        <field name="name">Active Inventory</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="domain">[('is_car_vehicle', '=', True), ('active', '=', True), ('car_status', 'not in', ['sold', 'delivered'])]</field>
        <field name="search_view_id" ref="view_stock_lot_search_car_management"/>
        <field name="context">{'search_default_filter_active_inventory': 1}</field>
    </record>

    <record id="action_car_inventory" model="ir.actions.act_window">
        <field name="name">All VIN Records</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="domain">[('is_car_vehicle', '=', True)]</field>
        <field name="search_view_id" ref="view_stock_lot_search_car_management"/>
    </record>

    <record id="action_car_sold_archive" model="ir.actions.act_window">
        <field name="name">Sold Archive</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="domain">[('is_car_vehicle', '=', True), '|', ('active', '=', False), ('car_status', 'in', ['sold', 'delivered'])]</field>
        <field name="search_view_id" ref="view_stock_lot_search_car_management"/>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="action_car_reports" model="ir.actions.act_window">
        <field name="name">Executive Overview</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">graph,pivot,list,kanban,form</field>
        <field name="domain">[('is_car_vehicle', '=', True)]</field>
        <field name="search_view_id" ref="view_stock_lot_search_car_management"/>
    </record>

    <record id="action_car_shipment_pipeline" model="ir.actions.act_window">
        <field name="name">Shipment Pipeline</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="domain">[('is_car_vehicle', '=', True), ('car_status', 'in', ['incoming', 'in_shipment', 'customs', 'received', 'in_preparation'])]</field>
        <field name="search_view_id" ref="view_stock_lot_search_car_management"/>
    </record>
</odoo>
