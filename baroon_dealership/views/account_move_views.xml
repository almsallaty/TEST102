<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_baroon_dealership" model="ir.ui.view">
        <field name="name">account.move.form.baroon.dealership</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Dealership Cars" invisible="move_type not in ('in_invoice', 'in_refund', 'entry')">
                    <group>
                        <field name="dealership_lot_ids" widget="many2many_tags" domain="[('is_car_vehicle', '=', True)]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
