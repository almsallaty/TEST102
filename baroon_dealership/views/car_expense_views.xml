<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_expense_list" model="ir.ui.view">
        <field name="name">car.expense.list</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="expense_date"/>
                <field name="lot_id"/>
                <field name="expense_type"/>
                <field name="name"/>
                <field name="vendor_id" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="account_move_id" optional="show"/>
                <field name="landed_cost_id" optional="show"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_car_expense_form" model="ir.ui.view">
        <field name="name">car.expense.form</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="expense_type"/>
                            <field name="name"/>
                            <field name="expense_date"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="reference"/>
                            <field name="account_move_id"/>
                            <field name="landed_cost_id"/>
                            <field name="purchase_order_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_car_expense_graph" model="ir.ui.view">
        <field name="name">car.expense.graph</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <graph string="Car Cost Analysis" type="bar">
                <field name="expense_type" type="row"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_car_expense_pivot" model="ir.ui.view">
        <field name="name">car.expense.pivot</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <pivot string="Car Expense Pivot">
                <field name="expense_type" type="row"/>
                <field name="vendor_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_car_expense_search" model="ir.ui.view">
        <field name="name">car.expense.search</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id"/>
                <field name="expense_type"/>
                <field name="vendor_id"/>
                <filter string="Shipping" name="filter_shipping" domain="[('expense_type', '=', 'shipping')]"/>
                <filter string="Customs" name="filter_customs" domain="[('expense_type', '=', 'customs')]"/>
                <filter string="Reconditioning" name="filter_reconditioning" domain="[('expense_type', '=', 'reconditioning')]"/>
                <filter string="Group by Type" name="group_type" context="{'group_by': 'expense_type'}"/>
                <filter string="Group by Car" name="group_car" context="{'group_by': 'lot_id'}"/>
                <filter string="Group by Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
            </search>
        </field>
    </record>
</odoo>
