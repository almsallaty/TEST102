<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_expense_list" model="ir.ui.view">
        <field name="name">car.expense.list</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="expense_date"/>
                <field name="lot_id"/>
                <field name="name"/>
                <field name="expense_type"/>
                <field name="vendor_id" optional="show"/>
                <field name="account_move_id" optional="show"/>
                <field name="landed_cost_id" optional="show"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_car_expense_form" model="ir.ui.view">
        <field name="name">car.expense.form</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="name"/>
                            <field name="expense_type"/>
                            <field name="expense_date"/>
                            <field name="vendor_id"/>
                            <field name="amount"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="account_move_id"/>
                            <field name="landed_cost_id"/>
                            <field name="purchase_order_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_car_expenses" model="ir.actions.act_window">
        <field name="name">Car Expenses</field>
        <field name="res_model">car.expense</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>

    <record id="view_car_expense_graph" model="ir.ui.view">
        <field name="name">car.expense.graph</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <graph string="Car Expenses" type="bar">
                <field name="expense_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_car_expense_pivot" model="ir.ui.view">
        <field name="name">car.expense.pivot</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <pivot string="Car Expenses">
                <field name="expense_type" type="row"/>
                <field name="lot_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
