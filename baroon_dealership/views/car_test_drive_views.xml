<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_test_drive_list" model="ir.ui.view">
        <field name="name">car.test.drive.list</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="lot_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="scheduled_datetime"/>
                <field name="state"/>
                <field name="sale_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_car_test_drive_form" model="ir.ui.view">
        <field name="name">car.test.drive.form</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_checkout" type="object" string="Check Out" class="btn-primary" invisible="state not in ('draft', 'scheduled')"/>
                    <button name="action_return" type="object" string="Return" class="btn-secondary" invisible="state != 'checked_out'"/>
                    <button name="action_create_quotation" type="object" string="Create Quotation" class="btn-primary" invisible="sale_order_id or state == 'cancelled'"/>
                    <button name="action_open_quotation" type="object" string="Open Quotation" class="btn-secondary" invisible="not sale_order_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('returned', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,checked_out,returned,quoted,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="lot_id"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="scheduled_datetime"/>
                            <field name="expected_return_datetime"/>
                            <field name="actual_checkout_datetime" readonly="1"/>
                            <field name="actual_return_datetime" readonly="1"/>
                            <field name="pickup_location_id"/>
                            <field name="return_location_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Compliance">
                            <group>
                                <group>
                                    <field name="driver_license_no"/>
                                    <field name="passport_no"/>
                                    <field name="national_id_no"/>
                                </group>
                                <group>
                                    <field name="insurance_provider"/>
                                    <field name="insurance_policy_no"/>
                                    <field name="security_deposit"/>
                                    <field name="deposit_collected"/>
                                </group>
                            </group>
                        </page>
                        <page string="Vehicle Check Out / Return">
                            <group>
                                <group>
                                    <field name="odometer_out"/>
                                    <field name="fuel_out"/>
                                    <field name="scratch_report_out" widget="text"/>
                                    <field name="pickup_checklist" widget="text"/>
                                </group>
                                <group>
                                    <field name="odometer_in"/>
                                    <field name="fuel_in"/>
                                    <field name="scratch_report_in" widget="text"/>
                                    <field name="return_checklist" widget="text"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="route_notes" widget="text"/>
                            <field name="note" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_car_test_drives" model="ir.actions.act_window">
        <field name="name">Test Drives</field>
        <field name="res_model">car.test.drive</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
            </record>

    <record id="view_car_test_drive_calendar" model="ir.ui.view">
        <field name="name">car.test.drive.calendar</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <calendar string="Test Drives" date_start="scheduled_datetime" date_stop="expected_return_datetime" color="user_id">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_car_test_drive_graph" model="ir.ui.view">
        <field name="name">car.test.drive.graph</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <graph string="Test Drives" type="bar">
                <field name="state"/>
                <field name="id" type="measure" string="Count"/>
            </graph>
        </field>
    </record>

    <record id="view_car_test_drive_pivot" model="ir.ui.view">
        <field name="name">car.test.drive.pivot</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <pivot string="Test Drives">
                <field name="state" type="row"/>
                <field name="user_id" type="col"/>
                <field name="id" type="measure" string="Count"/>
            </pivot>
        </field>
    </record>
</odoo>
