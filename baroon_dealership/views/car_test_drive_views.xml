<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_test_drive_list" model="ir.ui.view">
        <field name="name">car.test.drive.list</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="scheduled_datetime"/>
                <field name="lot_id"/>
                <field name="partner_id" optional="show"/>
                <field name="lead_id" optional="show"/>
                <field name="salesperson_id" optional="show"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_car_test_drive_form" model="ir.ui.view">
        <field name="name">car.test.drive.form</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="lot_id" options="{'no_open': False}"/>
                            <field name="lead_id" options="{'no_open': False}"/>
                            <field name="partner_id" options="{'no_open': False}"/>
                            <field name="salesperson_id"/>
                        </group>
                        <group>
                            <field name="scheduled_datetime"/>
                            <field name="duration"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" widget="text"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_car_test_drive_calendar" model="ir.ui.view">
        <field name="name">car.test.drive.calendar</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <calendar string="Test Drives" date_start="scheduled_datetime" color="salesperson_id">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="partner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_car_test_drive_search" model="ir.ui.view">
        <field name="name">car.test.drive.search</field>
        <field name="model">car.test.drive</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lot_id"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <filter string="Group by Car" name="group_car" context="{'group_by':'lot_id'}"/>
                <filter string="Group by Salesperson" name="group_salesperson" context="{'group_by':'salesperson_id'}"/>
                <filter string="Group by State" name="group_state" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>
</odoo>
