<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_lot_image_list" model="ir.ui.view">
        <field name="name">car.lot.image.list</field>
        <field name="model">car.lot.image</field>
        <field name="arch" type="xml">

            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="image_type"/>
                <field name="avatar" widget="image" options="{'size': [96, 96]}"/>
                <field name="capture_method"/>
                <field name="capture_date" optional="show"/>
                <field name="file_size" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_car_lot_image_form" model="ir.ui.view">
        <field name="name">car.lot.image.form</field>
        <field name="model">car.lot.image</field>
        <field name="arch" type="xml">

            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="name"/>
                            <field name="image_type"/>
                            <field name="sequence"/>
                            <field name="capture_method"/>
                            <field name="capture_date"/>
                            <field name="file_size"/>
                            <field name="note"/>
                            <field name="image_filename"/>
                        </group>
                        <group>
                            <field name="avatar" widget="image" options="{'size': [420, 420]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_lot_form_car_management" model="ir.ui.view">
        <field name="name">stock.lot.form.car.management</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                    <button type="object" name="action_transfer_car" class="oe_stat_button" icon="fa-exchange" invisible="not is_car_vehicle or not current_location_id or not active">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Transfer Car</span>
                        </div>
                    </button>
                    <button type="object" name="action_view_opportunities" class="oe_stat_button" icon="fa-handshake-o" invisible="not is_car_vehicle">
                        <field name="crm_lead_count" string="Opportunities" widget="statinfo"/>
                    </button>
                    <button type="object" name="action_view_sales_documents" class="oe_stat_button" icon="fa-file-text-o" invisible="not is_car_vehicle">
                        <field name="quotation_count" string="Sales Docs" widget="statinfo"/>
                    </button>
                    <button type="object" name="action_view_test_drives" class="oe_stat_button" icon="fa-road" invisible="not is_car_vehicle">
                        <field name="test_drive_count" string="Test Drives" widget="statinfo"/>
                    </button>
                    <button type="object" name="action_view_expenses" class="oe_stat_button" icon="fa-money" invisible="not is_car_vehicle">
                        <field name="expense_total" string="Expenses" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </button>
                    <button type="object" name="action_view_landed_costs" class="oe_stat_button" icon="fa-ship" invisible="not is_car_vehicle">
                        <field name="landed_cost_total" string="Landed Cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </button>
                    <button type="object" name="action_view_vendor_bills" class="oe_stat_button" icon="fa-credit-card" invisible="not is_car_vehicle">
                        <field name="vendor_bill_count" string="Bills" widget="statinfo"/>
                    </button>
                    <button type="object" name="action_view_transfers" class="oe_stat_button" icon="fa-exchange" invisible="not is_car_vehicle">
                        <field name="transfer_count" string="Transfers" widget="statinfo"/>
                    </button>
                    <button type="object" name="action_view_audit_log" class="oe_stat_button" icon="fa-history" invisible="not is_car_vehicle">
                        <field name="audit_log_count" string="Audit" widget="statinfo"/>
                    </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                    

                <group string="Dealership Workflow" invisible="not is_car_vehicle" col="2">
                    <group string="Status &amp; KPIs" col="1">
                        <field name="car_status" widget="statusbar" statusbar_visible="draft,incoming,in_shipment,customs,received,in_preparation,available,reserved,sold,delivered"/>
                        <group col="2">
                            <field name="current_location_id" readonly="1"/>
                            <field name="movement_command" readonly="1"/>
                            <field name="days_in_stock" readonly="1"/>
                            <field name="days_to_arrival" readonly="1"/>
                        </group>
                    </group>
                    <group string="Actions" col="2">
                        <button type="object" name="action_create_test_drive" string="New Test Drive" class="btn-secondary" invisible="not active or car_status not in ('available', 'reserved')"/>
                        <button type="object" name="action_release_reservation" string="Release Reservation" class="btn-secondary" invisible="car_status != 'reserved'"/>
                        <button type="object" name="action_print_car_profile" string="Car Profile" class="btn-secondary"/>
                        <button type="object" name="action_print_car_profitability" string="Profitability" class="btn-secondary"/>
                        <button type="object" name="action_print_car_accounting" string="Accounting" class="btn-secondary"/>
                        <button type="object" name="action_print_car_movement" string="Movement" class="btn-secondary"/>
                        <button type="object" name="action_print_car_operations_pack" string="Operations Pack" class="btn-secondary"/>
                    </group>
                </group>

                <group string="Car Identity" invisible="not is_car_vehicle">
                    <group string="Vehicle Profile">
                        <field name="name" string="VIN / Serial"/>
                                                <field name="product_id"/>
                        <field name="car_brand"/>
                        <field name="car_model"/>
                        <field name="car_trim"/>
                        <field name="year"/>
                        <field name="condition"/>
                    </group>
                    <group string="Commercial Snapshot">
                        <field name="car_image" widget="image" options="{'size': [220, 180]}"/>
                        <field name="kanban_image" widget="image" options="{'size': [220, 180]}"/>
                        <field name="sale_price"/>
                        <field name="minimum_sale_price"/>
                    </group>
                </group>

                <group string="Quick KPIs" invisible="not is_car_vehicle">
                    <group>
                        <field name="last_movement_date" readonly="1"/>
                        <field name="expense_total" readonly="1"/>
                    </group>
                    <group>
                        <field name="total_cost" readonly="1"/>
                        <field name="gross_margin" readonly="1"/>
                        <field name="margin_percent" readonly="1"/>
                    </group>
                </group>

                <notebook invisible="not is_car_vehicle">
                    <page string="Overview">
                        <group>
                            <group string="Identity &amp; Registration">
                                <field name="engine_number"/>
                                <field name="plate_number"/>
                                <field name="body_style"/>
                                <field name="doors"/>
                                <field name="seats"/>
                                <field name="drivetrain"/>
                            </group>
                            <group string="Listing &amp; Publication">
                                <field name="website_published"/>
                                <field name="website_sequence"/>
                                <field name="website_url" widget="url" readonly="1"/>
                                <field name="is_car_profile_complete" readonly="1"/>
                                <field name="website_short_description"/>
                            </group>
                        </group>
                        <group string="Technical">
                            <group>
                                <field name="mileage"/>
                                <field name="horse_power"/>
                                <field name="engine_size"/>
                            </group>
                            <group>
                                <field name="fuel_type"/>
                                <field name="gearbox_type"/>
                                <field name="branch_location"/>
                            </group>
                        </group>
                        <group string="Internal Notes">
                            <field name="notes" widget="text"/>
                        </group>
                    </page>

                    <page string="Purchase &amp; Shipment">
                        <group>
                            <group string="Procurement">
                                <field name="purchase_partner_id"/>
                                <field name="purchase_order_id"/>
                                <field name="purchase_line_id"/>
                                <field name="purchase_date"/>
                                <field name="purchase_cost"/>
                            </group>
                            <group string="Logistics">
                                <field name="shipping_reference"/>
                                <field name="port_of_loading"/>
                                <field name="destination_port"/>
                                <field name="expected_arrival_date"/>
                                <field name="arrival_date"/>
                                <field name="customs_release_date"/>
                            </group>
                        </group>
                        <field name="shipping_notes" widget="text"/>
                    </page>

                    <page string="Sales &amp; CRM">
                        <group>
                            <group string="Reservation">
                                <field name="reservation_order_id" readonly="1"/>
                                <field name="reservation_partner_id" readonly="1"/>
                                <field name="reserved_until" readonly="1"/>
                            </group>
                            <group string="Completed Sale">
                                <field name="sale_order_id" readonly="1"/>
                                <field name="buyer_id" readonly="1"/>
                                <field name="salesperson_id" readonly="1"/>
                                <field name="sold_date" readonly="1"/>
                                <field name="delivered_date" readonly="1"/>
                            </group>
                        </group>
                        <field name="crm_lead_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="stage_id"/>
                                <field name="user_id"/>
                            </list>
                        </field>
                    </page>

                    <page string="Costs">
                        <group>
                            <group>
                                <field name="purchase_cost" readonly="1"/>
                                <field name="landed_cost"/>
                                <field name="landed_cost_total" readonly="1"/>
                                <field name="reconditioning_cost"/>
                            </group>
                            <group>
                                <field name="expense_total" readonly="1"/>
                                <field name="total_cost" readonly="1"/>
                                <field name="sale_price"/>
                                <field name="gross_margin" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <button type="object" name="action_view_vendor_bills" string="Open Vendor Bills" class="btn-secondary"/>
                            </group>
                            <group>
                                <button type="object" name="action_view_landed_costs" string="Open Landed Costs" class="btn-secondary"/>
                            </group>
                        </group>
                        <field name="expense_ids" widget="one2many_list" nolabel="1" context="{'default_lot_id': id}">
                            <list editable="bottom">
                                <field name="expense_date"/>
                                <field name="name"/>
                                <field name="expense_type"/>
                                <field name="vendor_id"/>
                                <field name="account_move_id" optional="show"/>
                                <field name="bill_payment_state" optional="show"/>
                                <field name="landed_cost_id" optional="show"/>
                                <field name="amount"/>
                                <button name="action_create_vendor_bill" type="object" string="Create Bill" invisible="account_move_id or not vendor_id"/>
                                <button name="action_open_vendor_bill" type="object" string="Open Bill" invisible="not account_move_id"/>
                                <field name="state"/>
                            </list>
                        </field>
                        <field name="vendor_bill_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="move_type"/>
                                <field name="partner_id"/>
                                <field name="invoice_date"/>
                                <field name="amount_total"/>
                                <field name="payment_state"/>
                                <field name="state"/>
                            </list>
                        </field>
                        <field name="landed_cost_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="amount_total"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>

                    <page string="Movement">
                        <field name="location_history_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="movement_date"/>
                                <field name="movement_type"/>
                                <field name="source_location_id"/>
                                <field name="destination_location_id"/>
                                <field name="picking_id"/>
                                <field name="user_id"/>
                            </list>
                        </field>
                    </page>

                    <page string="Images">
                        <group>
                            <group>
                                <field name="car_image" widget="image" options="{'size': [280, 220]}"/>
                            </group>
                            <group>
                                <field name="kanban_image" widget="image" options="{'size': [280, 220]}"/>
                            </group>
                        </group>
                        <field name="gallery_image_ids" widget="car_image_gallery_one2many" nolabel="1" context="{'default_lot_id': id}"/>
                    </page>

                    <page string="Test Drives">
                        <field name="test_drive_ids" nolabel="1" context="{'default_lot_id': id}">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="scheduled_datetime"/>
                                <field name="state"/>
                                <field name="security_deposit" optional="show"/>
                                <field name="deposit_invoice_id" optional="show"/>
                                <field name="deposit_payment_state" optional="show"/>
                                <field name="deposit_refund_id" optional="show"/>
                                <field name="sale_order_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_list_car_management" model="ir.ui.view">
        <field name="name">stock.lot.list.car.management</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">0</attribute>
                <attribute name="create">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="kanban_image" widget="image" optional="show" options="{'size': [72,72]}"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="car_status"/>
                <field name="car_brand" optional="show"/>
                <field name="car_model" optional="show"/>
                <field name="year" optional="show"/>
                <field name="engine_number" optional="show"/>
                <field name="plate_number" optional="show"/>
                <field name="current_location_id" optional="show"/>
                <field name="sale_price" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_kanban_car_management" model="ir.ui.view">
        <field name="name">stock.lot.kanban.car.management</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">

            <kanban default_group_by="car_status" class="o_kanban_mobile" records_draggable="false">
                <field name="kanban_image"/>
                <field name="car_status"/>
                <field name="car_brand"/>
                <field name="car_model"/>
                <field name="car_trim"/>
                <field name="year"/>
                <field name="sale_price"/>
                <field name="currency_id"/>
                <field name="current_location_id"/>
                <field name="days_in_stock"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_image_top text-center mb-2">
                                <field name="kanban_image" widget="image" class="img img-fluid" options="{'preview_image': 'kanban_image'}"/>
                            </div>
                            <div class="o_kanban_details">
                                <strong>
                                    <t t-esc="(record.car_brand and record.car_brand.value) or ''"/>
                                    <t t-if="record.car_model and record.car_model.value"> <t t-esc="record.car_model.value"/></t>
                                </strong>
                                <div class="text-muted small">
                                    <t t-if="record.year and record.year.raw_value"><t t-esc="record.year.value"/> • </t>
                                    <t t-esc="(record.car_status and record.car_status.value) or ''"/>
                                </div>
                                <div class="small mt-1">
                                    <span t-if="record.current_location_id and record.current_location_id.value"><i class="fa fa-map-marker me-1"/><t t-esc="record.current_location_id.value"/></span>
                                </div>
                                <div class="d-flex justify-content-between mt-2">
                                    <span class="small text-muted">Days: <t t-esc="record.days_in_stock.raw_value or 0"/></span>
                                    <span><field name="sale_price" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
