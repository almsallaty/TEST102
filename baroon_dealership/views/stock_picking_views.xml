<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_baroon_dealership" model="ir.ui.view">
        <field name="name">stock.picking.form.baroon.dealership</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dealership_cars" type="object" class="oe_stat_button" icon="fa-car" invisible="dealership_lot_count == 0">
                    <field name="dealership_lot_count" string="Cars" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="Cars on This Transfer" invisible="dealership_lot_count == 0">
                    <field name="dealership_lot_ids" widget="many2many_tags" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
