<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_car_management" model="ir.ui.view">
        <field name="name">product.template.form.car.management</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_car_lots" type="object" class="oe_stat_button" icon="fa-car" invisible="not is_car_vehicle">
                    <field name="lot_count" string="VIN Records" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="is_car_vehicle"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Car Profile" invisible="not is_car_vehicle">
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="trim"/>
                            <field name="body_style"/>
                        </group>
                        <group>
                            <field name="doors"/>
                            <field name="seats"/>
                            <field name="drivetrain"/>
                            <field name="list_price"/>
                        </group>
                    </group>
                    <group string="Inventory">
                        <group>
                            <field name="active_car_count" readonly="1"/>
                            <field name="sold_car_count" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
