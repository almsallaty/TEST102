<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_baroon_dealership" model="ir.ui.view">
        <field name="name">crm.lead.form.baroon.dealership</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="sale_order_count == 0">
                    <field name="sale_order_count" string="Sale Orders" widget="statinfo"/>
                </button>
                <button name="action_view_test_drives" type="object" class="oe_stat_button" icon="fa-road" invisible="test_drive_count == 0">
                    <field name="test_drive_count" string="Test Drives" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="car_lot_id" options="{'no_open': False}"/>
                <field name="car_product_id" readonly="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_sale_order" type="object" string="Create Quotation" class="btn-primary" invisible="not car_lot_id or type == 'lead'"/>
                <button name="action_create_test_drive" type="object" string="Schedule Test Drive" class="btn-secondary" invisible="not car_lot_id or type == 'lead'"/>
            </xpath>
        </field>
    </record>
</odoo>
