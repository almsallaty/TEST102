#. module: vehicle_rental
#: model:mail.template,body_html:vehicle_rental.scratch_report_review_signature_required_mail_template
msgid ""
"<h4>\n"
"                    Dear\n"
"                    <strong>\n"
"                        <t t-out=\"object.customer_id.name\"/>\n"
"                    </strong>\n"
"                    ,\n"
"                </h4>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <h4>\n"
"                    Greetings from\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.name\"/>\n"
"                    </strong>\n"
"                </h4>\n"
"                <p>\n"
"                    This email is regarding your recently completed rental contract\n"
"                    <strong>\n"
"                        <t t-out=\"object.reference_no\"/>\n"
"                    </strong>\n"
"                    for the\n"
"                    <strong>\n"
"                        <t t-out=\"object.vehicle_id.name\"/>\n"
"                    </strong>\n"
"                    .\n"
"                </p>\n"
"                <p>\n"
"                    During the return inspection, our team identified scratch damage on the vehicle. A detailed Scratch\n"
"                    Report has been prepared.\n"
"                </p>\n"
"                <p>\n"
"                    To review the scratch details and provide your confirmation signature, please click the button\n"
"                    below:\n"
"                </p>\n"
"\n"
"                <a t-att-href=\"object.get_scratch_report_url()\" target=\"_blank\" class=\"btn btn-primary\">\n"
"                    View &amp; Sign Scratch Report\n"
"                </a>\n"
"                <p>\n"
"                    Kindly review the report carefully and submit your digital signature to complete the verification\n"
"                    process. This will allow us to proceed with the final settlement as per the rental agreement terms.\n"
"                </p>\n"
"                <p>\n"
"                    If you have any questions or require clarification regarding the report, please contact us at your\n"
"                    convenience.\n"
"                </p>\n"
"                <p>\n"
"                    Thank you for your prompt cooperation.\n"
"                </p>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <div>\n"
"                    <strong>\n"
"                        Best regards,\n"
"                        <br/>\n"
"                        <t t-out=\"object.responsible_id.name\"/>\n"
"                    </strong>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.name\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.phone\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.email\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.website\"/>\n"
"                </div>\n"
"            "
msgstr ""
"<h4                    عزيزي/عزيزت                    <strong<t "
"t-out=\"object.customer_id.name\"></t</strong"
"                                    </h4<hr style=\"margin: 0; padding: "
"0;\"/<h4                    تحياتنا م                    <strong<t "
"t-out=\"object.company_id.name\"></t</strong</h4<p                    تتعلق "
"هذه الرسالة بعقد الإيجار المكتمل مؤخرا                    <strong<t "
"t-out=\"object.reference_no\"></t</strong                    الخاص بالمركب"
"                    <strong<t t-out=\"object.vehicle_id.name\"></t</strong"
"                                    </p<p                    أثناء فحص "
"الاستلام، رصد فريقنا وجود خدوش على المركبة. وقد تم إعداد تقرير خدوش مفصل"
"                </p<p                    لمراجعة تفاصيل الخدوش وتقديم توقيعك"
" التأكيد، يرجى النقر على الزر أدناه                </p<a class=\"btn btn-"
"primary\" t-att-href=\"object.get_scratch_report_url()\" target=\"_blank\""
"                    عرض وتوقيع تقرير الخدو                </a<p"
"                    يرجى مراجعة التقرير بدقة وإرسال توقيعك الرقمي لإكمال "
"عملية التحقق. سيسمح لنا ذلك بالمضي قدماً في التسوية النهائية وفقاً لشروط "
"اتفاقية الإيجار                </p<p                    إذا كان لديك أي "
"استفسارات أو تحتاج إلى توضيح بخصوص التقرير، يرجى التواصل معنا في أي وقت "
"يناسبك                </p<p                    نشكركم على تعاونكم السريع"
"                </p<hr style=\"margin: 0; padding: 0;\"/<div<strong"
"                        مع أطيب التحيات                        <br/<t "
"t-out=\"object.responsible_id.name\"></t</strong<br/<t "
"t-out=\"object.company_id.name\"></t<br/<t "
"t-out=\"object.company_id.phone\"></t<br/<t "
"t-out=\"object.company_id.email\"></t<br/<t "
"t-out=\"object.company_id.website\"></t</div"

#. module: vehicle_rental
#: model:mail.template,body_html:vehicle_rental.vehicle_rental_booking_confirmation_mail_template
msgid ""
"<h4>\n"
"                    Dear\n"
"                    <strong>\n"
"                        <t t-out=\"object.customer_id.name\"/>\n"
"                    </strong>\n"
"                    ,\n"
"                </h4>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <p>\n"
"                    Thank you for booking with\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.name\"/>\n"
"                    </strong>\n"
"                    . Below are your rental details:\n"
"                </p>\n"
"                <hr style=\"margin: 5px;\"/>\n"
"                <table class=\"table table-bordered\" style=\"width:100%; border-collapse:collapse;\">\n"
"                    <!-- Reference & Vehicle -->\n"
"                    <tr>\n"
"                        <td style=\"width: 35%; padding: 5px;\">\n"
"                            <strong>Reference No.</strong>\n"
"                        </td>\n"
"                        <td style=\"width: 65%; padding: 5px;\">\n"
"                            <span t-field=\"object.reference_no\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 35%; padding: 5px;\">\n"
"                            <strong>Vehicle</strong>\n"
"                        </td>\n"
"                        <td style=\"width: 65%; padding: 5px;\">\n"
"                            <span t-field=\"object.vehicle_id.name\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <!-- Pickup Section -->\n"
"                    <tr>\n"
"                        <td colspan=\"2\" style=\"width: 100%; background-color:#f2f2f2; padding: 5px;\">\n"
"                            <strong>Pickup Details</strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 35%; padding: 5px;\">\n"
"                            <strong>Pickup Date</strong>\n"
"                        </td>\n"
"                        <td style=\"width: 65%; padding: 5px;\">\n"
"                            <span t-field=\"object.start_date\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"vertical-align: middle; width: 35%; padding: 5px;\">\n"
"                            <strong>Pickup Address</strong>\n"
"                        </td>\n"
"                        <td style=\"width: 65%; padding: 5px;\">\n"
"                            <t t-if=\"object.pick_up_street\">\n"
"                                <span t-field=\"object.pick_up_street\"/>\n"
"                                <br/>\n"
"                            </t>\n"
"                            <t t-if=\"object.pick_up_street2\">\n"
"                                <span t-field=\"object.pick_up_street2\"/>\n"
"                                <br/>\n"
"                            </t>\n"
"                            <t t-if=\"object.pick_up_city\">\n"
"                                <span t-field=\"object.pick_up_city\"/>\n"
"                                <span t-field=\"object.pick_up_state_id.name\"/>\n"
"                                <span t-field=\"object.pick_up_zip\"/>\n"
"                                <br/>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <!-- Return Section -->\n"
"                    <tr>\n"
"                        <td colspan=\"2\" style=\"width: 100%; background-color:#f2f2f2; padding: 5px;\">\n"
"                            <strong>Return Details</strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"width: 35%; padding: 5px;\">\n"
"                            <strong>Drop-off Date</strong>\n"
"                        </td>\n"
"                        <td style=\"width: 65%; padding: 5px;\">\n"
"                            <span t-field=\"object.end_date\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"vertical-align: middle; padding: 5px;\">\n"
"                            <strong>Drop-off Address</strong>\n"
"                        </td>\n"
"                        <td style=\"width: 65%; padding: 5px;\">\n"
"                            <t t-if=\"object.drop_off_street\">\n"
"                                <span t-field=\"object.drop_off_street\"/>\n"
"                                <br/>\n"
"                            </t>\n"
"                            <t t-if=\"object.drop_off_street2\">\n"
"                                <span t-field=\"object.drop_off_street2\"/>\n"
"                                <br/>\n"
"                            </t>\n"
"                            <t t-if=\"object.drop_off_city\">\n"
"                                <span t-field=\"object.drop_off_city\"/>\n"
"                                <span t-field=\"object.drop_off_state_id.name\"/>\n"
"                                <span t-field=\"object.drop_off_zip\"/>\n"
"                                <br/>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <hr style=\"margin: 5px;\"/>\n"
"                <p>\n"
"                    Please be available at the pickup location on time and carry your required documents.\n"
"                </p>\n"
"                <p>\n"
"                    For any support or changes, feel free to contact us.\n"
"                </p>\n"
"                <p>\n"
"                    Have a great trip!\n"
"                </p>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <span>\n"
"                    <strong>\n"
"                        Best regards,\n"
"                        <br/>\n"
"                        <t t-out=\"object.responsible_id.name\"/>\n"
"                    </strong>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.name\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.phone\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.email\"/>\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.website\"/>\n"
"                </span>\n"
"            "
msgstr ""
"<h4                    عزيزي/عزيزت                    <strong<t "
"t-out=\"object.customer_id.name\"></t</strong"
"                                    </h4<hr style=\"margin: 0; padding: "
"0;\"/<p                    شكراً لك على الحجز م                    <strong<t"
" t-out=\"object.company_id.name\"></t</strong                    . فيما يلي "
"تفاصيل الإيجار الخاصة بك                </p<hr style=\"margin: 5px;\"/<table"
" class=\"table table-bordered\" style=\"width:100%; border-"
"collapse:collapse;\" <!-- المرجع والمركبة --<tr<td style=\"width: 35%; "
"padding: 5px;\"<strong>الرقم المرجعي</strong</td<td style=\"width: 65%; "
"padding: 5px;\"<span t-field=\"object.reference_no\"></span</td</tr<tr<td "
"style=\"width: 35%; padding: 5px;\"<strong>المركبة</strong</td<td "
"style=\"width: 65%; padding: 5px;\"<span "
"t-field=\"object.vehicle_id.name\"></span</td</tr <!-- قسم الاستلام --<tr<td"
" colspan=\"2\" style=\"width: 100%; background-color:#f2f2f2; padding: "
"5px;\"<strong>تفاصيل الاستلام</strong</td</tr<tr<td style=\"width: 35%; "
"padding: 5px;\"<strong>تاريخ الاستلام</strong</td<td style=\"width: 65%; "
"padding: 5px;\"<span t-field=\"object.start_date\"></span</td</tr<tr<td "
"style=\"vertical-align: middle; width: 35%; padding: 5px;\"<strong>عنوان "
"الاستلام</strong</td<td style=\"width: 65%; padding: 5px;\"<t "
"t-if=\"object.pick_up_street\"<span "
"t-field=\"object.pick_up_street\"></span<br/</t<t "
"t-if=\"object.pick_up_street2\"<span "
"t-field=\"object.pick_up_street2\"></span<br/</t<t "
"t-if=\"object.pick_up_city\"<span "
"t-field=\"object.pick_up_city\"></span<span "
"t-field=\"object.pick_up_state_id.name\"></span<span "
"t-field=\"object.pick_up_zip\"></span<br/</t<t "
"t-if=\"object.pick_up_country_id\"<span "
"t-field=\"object.pick_up_country_id.name\"></span</t</td</tr <!-- قسم "
"الإرجاع --<tr<td colspan=\"2\" style=\"width: 100%; background-"
"color:#f2f2f2; padding: 5px;\"<strong>تفاصيل الإرجاع</strong</td</tr<tr<td "
"style=\"width: 35%; padding: 5px;\"<strong>تاريخ التسليم</strong</td<td "
"style=\"width: 65%; padding: 5px;\"<span "
"t-field=\"object.end_date\"></span</td</tr<tr<td style=\"vertical-align: "
"middle; padding: 5px;\"<strong>عنوان التسليم</strong</td<td style=\"width: "
"65%; padding: 5px;\"<t t-if=\"object.drop_off_street\"<span "
"t-field=\"object.drop_off_street\"></span<br/</t<t "
"t-if=\"object.drop_off_street2\"<span "
"t-field=\"object.drop_off_street2\"></span<br/</t<t "
"t-if=\"object.drop_off_city\"<span "
"t-field=\"object.drop_off_city\"></span<span "
"t-field=\"object.drop_off_state_id.name\"></span<span "
"t-field=\"object.drop_off_zip\"></span<br/</t<t "
"t-if=\"object.drop_off_country_id\"<span "
"t-field=\"object.drop_off_country_id.name\"></span</t</td</tr</table<hr "
"style=\"margin: 5px;\"/<p                    يرجى التواجد في موقع الاستلام "
"في الوقت المحدد وحمل المستندات المطلوبة                </p<p"
"                    لأي دعم أو تعديلات، لا تتردد في التواصل معنا"
"                </p<p                    نتمنى لك رحلة سعيدة                "
"</p<hr style=\"margin: 0; padding: 0;\"/<span<strong                        "
"مع أطيب التحيات                        <br/<t "
"t-out=\"object.responsible_id.name\"></t</strong<br/<t "
"t-out=\"object.company_id.name\"></t<br/<t "
"t-out=\"object.company_id.phone\"></t<br/<t "
"t-out=\"object.company_id.email\"></t<br/<t "
"t-out=\"object.company_id.website\"></t</span"

#. module: vehicle_rental
#: model:mail.template,body_html:vehicle_rental.successful_booking_creation_mail_template
msgid ""
"<h4>\n"
"                    Dear\n"
"                    <strong>\n"
"                        <t t-out=\"object.customer_id.name\"/>\n"
"                    </strong>\n"
"                    ,\n"
"                </h4>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <p>\n"
"                    Your vehicle rental booking has been successfully recorded.\n"
"                </p>\n"
"                <p>\n"
"                    Reference Number:\n"
"                    <strong>\n"
"                        <t t-out=\"object.reference_no\"/>\n"
"                    </strong>\n"
"                </p>\n"
"                <p>\n"
"                    You will receive further instructions regarding pickup and documentation shortly.\n"
"                </p>\n"
"                <p>\n"
"                    Thank you for your trust in our services.\n"
"                </p>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <strong>\n"
"                    Regards,\n"
"                    <br/>\n"
"                    <t t-out=\"object.company_id.name\"/>\n"
"                </strong>\n"
"            "
msgstr ""
"<h4                    عزيزي/عزيزت                    <strong"
"                        <t t-out=\"object.customer_id.name\"/"
"                    </strong                                    </h4"
"                <hr style=\"margin: 0; padding: 0;\"/                <p"
"                    تم تسجيل حجز إيجار سيارتك بنجاح                </p"
"                <p                    الرقم المرجعي                    "
"<strong                        <t t-out=\"object.reference_no\"/"
"                    </strong                </p                <p"
"                    ستتلقى قريباً تعليمات إضافية بخصوص الاستلام والمستندات "
"المطلوبة                </p                <p                    نشكرك على "
"ثقتك في خدماتنا                </p                <hr style=\"margin: 0; "
"padding: 0;\"/                <strong                    مع التحية"
"                    <br/                    <t "
"t-out=\"object.company_id.name\"/                </strong"

#. module: vehicle_rental
#: model:mail.template,body_html:vehicle_rental.vehicle_maintenance_request_mail_template
msgid ""
"<h4>\n"
"                    Dear\n"
"                    <strong>\n"
"                        <t t-out=\"object.manager_id.name\"/>\n"
"                    </strong>\n"
"                    ,\n"
"                </h4>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <p>\n"
"                    A new maintenance request has been created for the following vehicle:\n"
"                </p>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <span>\n"
"                    <strong>\n"
"                        Vehicle Details\n"
"                    </strong>\n"
"                </span>\n"
"                <hr style=\"margin: 0; padding: 0;\"/>\n"
"                <table class=\"table table-bordered\" style=\"width:100%; border-collapse:collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <strong>Vehicle</strong>\n"
"                        </td>\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <span t-field=\"object.name\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.driver_id\">\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <strong>Driver</strong>\n"
"                        </td>\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <span t-field=\"object.driver_id\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <strong>Request Date</strong>\n"
"                        </td>\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <t t-out=\"object.env.context.get('request_date')\"/>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.maintenance_schedule_id\">\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <strong>Next Maintenance Schedule</strong>\n"
"                        </td>\n"
"                        <td style=\"padding: 2px;\">\n"
"                            <span t-field=\"object.maintenance_schedule_id\"/>\n"
"                        </td>\n"
"                    </tr>\n"
