<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <!-- ============================================
             ✅ عرض الشجرة (قائمة المستندات)
             ============================================ -->
        <record id="customer_documents_tree_view" model="ir.ui.view">
            <field name="name">customer.documents.list.view</field>
            <field name="model">customer.documents</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="partner_id"/>
                    <field name="document_type"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <field name="vehicle_contract_id" optional="hide"/>
                    <field name="vehicle_id" optional="hide"/>
                    <field name="file_name" column_invisible="True"/>
                    <field name="avatar" filename="file_name" widget="binary"/>
                    <field name="notes" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ============================================
             ✅ عرض النموذج
             ============================================ -->
        <record id="customer_documents_form_view" model="ir.ui.view">
            <field name="name">customer.documents.form.view</field>
            <field name="model">customer.documents</field>
            <field name="arch" type="xml">
                <form string="مستند العميل">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="document_type"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="partner_id" required="1"/>
                                <field name="vehicle_contract_id"/>
                                <field name="vehicle_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="file_name" invisible="1"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <field name="avatar" filename="file_name" widget="binary"/>
                            </group>
                            <group>
                                <field name="notes" placeholder="أضف ملاحظات إضافية..."/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================
             ✅ إضافة المستندات في نموذج العميل
             ============================================ -->
        <record id="view_partner_form_documents_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.documents.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- زر المستندات -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button"
                            type="object"
                            name="action_view_customer_documents"
                            icon="fa-file-text-o">
                        <field name="document_count" widget="statinfo" string="المستندات"/>
                    </button>
                </xpath>

                <!-- تبويب المستندات -->
                <xpath expr="//notebook" position="inside">
                    <page string="المستندات" name="documents_page">
                        <field name="document_ids"
                               mode="tree,form"
                               context="{'default_partner_id': id}">

                            <list editable="bottom">
                                <field name="document_type" required="1"/>
                                <field name="issue_date"/>
                                <field name="expiry_date"
                                       decoration-danger="expiry_date &lt; context_today()"/>
                                <field name="file_name" column_invisible="True"/>
                                <field name="avatar" filename="file_name" widget="binary"/>
                                <field name="notes" optional="hide"/>
                            </list>

                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="document_type" required="1"/>
                                            <field name="issue_date"/>
                                            <field name="expiry_date"/>
                                        </group>
                                        <group>
                                            <field name="file_name" invisible="1"/>
                                            <field name="avatar" filename="file_name" widget="binary"/>
                                        </group>
                                    </group>
                                    <field name="notes" placeholder="ملاحظات..."/>
                                </sheet>
                            </form>

                        </field>
                    </page>
                </xpath>

            </field>
        </record>

        <!-- ============================================
             ✅ إضافة المستندات في نموذج العقد
             ============================================ -->
        <record id="vehicle_contract_form_documents_inherit" model="ir.ui.view">
            <field name="name">vehicle.contract.form.documents.inherit</field>
            <field name="model">vehicle.contract</field>
            <field name="inherit_id" ref="vehicle_contract_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="inside">
                    <page string="مستندات العميل" name="customer_documents_page">

                        <field name="customer_document_ids"
                               context="{'default_vehicle_contract_id': id}">

                            <list editable="bottom">
                                <field name="document_type" required="1"/>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="file_name" column_invisible="True"/>
                                <field name="avatar" filename="file_name" widget="binary"/>
                            </list>

                        </field>

                        <div class="alert alert-info mt-2" role="alert">
                            <strong>ملاحظة:</strong>
                            المستندات المضافة هنا مرتبطة بالعقد الحالي فقط.
                            لإضافة مستندات دائمة للعميل، انتقل إلى نموذج العميل.
                        </div>

                    </page>
                </xpath>

            </field>
        </record>

        <!-- ============================================
             ✅ الإجراء الرئيسي
             ============================================ -->
        <record id="action_customer_documents" model="ir.actions.act_window">
            <field name="name">مستندات العملاء</field>
            <field name="res_model">customer.documents</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">لا توجد مستندات</p>
                <p>أضف مستندات العملاء (رخصة، جواز، بطاقة هوية...)</p>
            </field>
        </record>

        <!-- ============================================
             ✅ القوائم
             ============================================ -->
        <menuitem id="menu_customer_documents_root"
                  name="المستندات"
                  parent="fleet.fleet_vehicles"
                  sequence="95"/>

        <menuitem id="menu_customer_documents"
                  name="مستندات العملاء"
                  parent="menu_customer_documents_root"
                  action="action_customer_documents"
                  sequence="1"/>

    </data>
</odoo>
