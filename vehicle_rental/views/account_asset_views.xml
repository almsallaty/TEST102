<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- وراثة نموذج الأصل لإضافة حقول المركبات -->
        <record id="account_asset_form_vehicle_inherit" model="ir.ui.view">
            <field name="name">account.asset.form.vehicle.inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                
                <!-- زر لفتح المركبة في الهيدر -->
                <xpath expr="//header" position="inside">
                    <button string="Open Vehicle" name="action_open_vehicle" type="object"
                            class="btn btn-secondary" invisible="not vehicle_id"
                            groups="fleet.fleet_group_manager,account.group_account_user"/>
                </xpath>
                
                <!-- إضافة قسم ربط المركبة -->
                <xpath expr="//sheet/group" position="inside">
                    <group string="Vehicle Link" colspan="2">
                        <field name="vehicle_id" domain="[('asset_id', '=', False)]" 
                               options="{'no_create': True}"/>
                        <field name="vehicle_vin" readonly="1"/>
                        <field name="purchase_order_id" groups="purchase.group_purchase_user"/>
                        <field name="vendor_bill_id" groups="account.group_account_user"/>
                    </group>
                </xpath>
                
            </field>
        </record>
    </data>
</odoo>
