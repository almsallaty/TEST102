<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- زر إحصائي في صندوق الأزرار -->
        <record id="view_partner_form_rental_button" model="ir.ui.view">
            <field name="name">res.partner.form.rental.button</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" 
                            name="action_view_rental_contracts" 
                            icon="fa-file-text-o"
                            groups="base.group_user">
                        <field string="عقود الإيجار" name="rental_contract_count" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
        
        <!-- تبويب سجل الإيجار -->
        <record id="view_partner_form_rental_history" model="ir.ui.view">
            <field name="name">res.partner.form.rental.history</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="سجل الإيجار" name="rental_history" groups="base.group_user">
                        <separator string="عقود الإيجار"/>
                        <field name="rental_contract_ids" 
                               readonly="1"
                               groups="base.group_user"
                               context="{'create': False, 'edit': False, 'delete': False}">
                            <list string="عقود الإيجار" create="False" edit="False" delete="False">
                                <field name="reference_no" string="رقم العقد"/>
                                <field name="vehicle_id" string="المركبة"/>
                                <field name="start_date" string="تاريخ الاستلام"/>
                                <field name="end_date" string="تاريخ التسليم"/>
                                <field name="total_vehicle_rent" string="قيمة الإيجار"/>
                                <field name="status" string="الحالة" widget="badge"
                                       decoration-info="status == 'a_draft'"
                                       decoration-warning="status == 'b_in_progress'"
                                       decoration-success="status == 'c_return'"
                                       decoration-danger="status == 'd_cancel'"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
