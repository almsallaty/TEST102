<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron: Send WhatsApp reminders 1 day before pickup/drop-off -->
        <record id="cron_send_whatsapp_contract_reminders" model="ir.cron">
            <field name="name">Vehicle Contract: Send WhatsApp Reminders</field>
            <field name="model_id" ref="model_vehicle_contract"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_whatsapp_reminders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <!-- ✅ Odoo 19: nextcall is set automatically, no need to specify -->
        </record>
        
    </data>
</odoo>
