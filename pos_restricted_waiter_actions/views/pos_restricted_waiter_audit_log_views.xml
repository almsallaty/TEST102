<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_restricted_waiter_audit_log_tree" model="ir.ui.view">
        <field name="name">pos.restricted.waiter.audit.log.tree</field>
        <field name="model">pos.restricted.waiter.audit.log</field>
        <field name="arch" type="xml">
            <list string="POS Restricted Waiter Audit Logs" create="false" edit="false" delete="false">
                <field name="timestamp"/>
                <field name="state"/>
                <field name="action"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="order_ref"/>
                <field name="table_name"/>
                <field name="product_name"/>
                <field name="old_qty"/>
                <field name="new_qty"/>
                <field name="session_id"/>
            </list>
        </field>
    </record>

    <record id="view_pos_restricted_waiter_audit_log_form" model="ir.ui.view">
        <field name="name">pos.restricted.waiter.audit.log.form</field>
        <field name="model">pos.restricted.waiter.audit.log</field>
        <field name="arch" type="xml">
            <form string="POS Restricted Waiter Audit Log" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="state"/>
                            <field name="action"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="session_id"/>
                            <field name="config_id"/>
                            <field name="order_ref"/>
                            <field name="table_name"/>
                            <field name="line_uuid"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_name"/>
                            <field name="old_qty"/>
                            <field name="new_qty"/>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_restricted_waiter_audit_log" model="ir.actions.act_window">
        <field name="name">Restricted Waiter Audit Logs</field>
        <field name="res_model">pos.restricted.waiter.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pos_restricted_waiter_audit_log_root"
              name="Restricted Waiter Logs"
              parent="point_of_sale.menu_point_root"
              action="action_pos_restricted_waiter_audit_log"
              sequence="95"
              groups="point_of_sale.group_pos_manager"/>
</odoo>
