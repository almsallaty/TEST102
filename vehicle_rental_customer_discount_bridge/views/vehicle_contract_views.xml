<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vehicle_contract_form_view_discount_bridge" model="ir.ui.view">
        <field name="name">vehicle.contract.form.discount.bridge</field>
        <field name="model">vehicle.contract</field>
        <field name="inherit_id" ref="vehicle_rental.vehicle_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='rental_vehicle_payment_details']" position="after">
                <page name="rental_contract_discount" string="Discount">
                    <group>
                        <group>
                            <field name="available_discount_profile_ids" invisible="1"/>
                            <field name="discount_locked" invisible="1"/>
                            <field name="discount_lock_reason" invisible="1"/>
                            <field name="discount_applied" readonly="1"/>
                        </group>
                        <group>
                            <field name="customer_phone" readonly="1"/>
                            <field name="customer_email" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="discount_reason" readonly="discount_locked or status in ['c_return', 'd_cancel']"/>
                            <field name="discount_type" readonly="discount_locked or status in ['c_return', 'd_cancel']"/>
                            <field name="discount_free_days" readonly="discount_locked or status in ['c_return', 'd_cancel']" invisible="discount_type != 'free_days'"/>
                            <field name="discount_fixed_amount" readonly="discount_locked or status in ['c_return', 'd_cancel']" invisible="discount_type != 'fixed_amount'"/>
                            <field name="discount_percentage" readonly="discount_locked or status in ['c_return', 'd_cancel']" invisible="discount_type != 'percentage'"/>
                            <field name="discount_product_id" readonly="discount_locked or status in ['c_return', 'd_cancel']"/>
                        </group>
                        <group>
                            <field name="discount_amount" readonly="1"/>
                            <field name="total_after_discount" readonly="1"/>
                            <label for="discount_lock_reason" invisible="not discount_locked"/>
                            <div invisible="not discount_locked">
                                <field name="discount_lock_reason" readonly="1" nolabel="1" class="text-warning"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group>
                            <button string="Apply Discount"
                                    name="action_apply_customer_discount"
                                    type="object"
                                    class="btn btn-primary"
                                    invisible="status in ['c_return', 'd_cancel'] or discount_locked"/>
                            <button string="Clear Discount"
                                    name="action_clear_customer_discount"
                                    type="object"
                                    class="btn btn-secondary"
                                    invisible="status in ['c_return', 'd_cancel'] or discount_applied == False or discount_locked"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
