<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_vehicle_discount_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.vehicle.discount.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Rental Discounts">
                    <field name="vehicle_discount_profile_ids" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="discount_type"/>
                            <field name="free_days" optional="hide"/>
                            <field name="fixed_amount" optional="hide"/>
                            <field name="percentage" optional="hide"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
