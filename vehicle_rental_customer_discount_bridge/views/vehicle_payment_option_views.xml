<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vehicle_payment_option_form_view_discount_bridge" model="ir.ui.view">
        <field name="name">vehicle.payment.option.form.discount.bridge</field>
        <field name="model">vehicle.payment.option</field>
        <field name="inherit_id" ref="vehicle_rental.vehicle_payment_option_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_amount']" position="after">
                <field name="base_payment_amount"/>
                <field name="discount_amount_applied"/>
            </xpath>
        </field>
    </record>
</odoo>
