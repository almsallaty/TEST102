<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_customer_discount_tree" model="ir.ui.view">
        <field name="name">vehicle.customer.discount.tree</field>
        <field name="model">vehicle.customer.discount</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="discount_type"/>
                <field name="display_value"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_customer_discount_form" model="ir.ui.view">
        <field name="name">vehicle.customer.discount.form</field>
        <field name="model">vehicle.customer.discount</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="discount_type"/>
                            <field name="free_days" invisible="discount_type != 'free_days'"/>
                            <field name="fixed_amount" invisible="discount_type != 'fixed_amount'"/>
                            <field name="percentage" invisible="discount_type != 'percentage'"/>
                            <field name="discount_product_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="reason" widget="text"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_customer_discount" model="ir.actions.act_window">
        <field name="name">Customer Discounts</field>
        <field name="res_model">vehicle.customer.discount</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vehicle_customer_discount"
              name="Customer Discounts"
              parent="vehicle_rental.menu_configuration"
              action="action_vehicle_customer_discount"
              sequence="85"/>
</odoo>
